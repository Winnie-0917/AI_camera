<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The artwork lives in the background layer: it is drawn full-bleed and is not put
         through the launcher's icon normalisation, which zooms a padded foreground to fill
         the mask and would crop the character's ears. -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
